# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shayari-diary?retryWrites=true&w=majority

# Long random secret used to sign admin session JWTs
JWT_SECRET=change-this-to-a-long-random-string

# One-time secret required to create the very first admin account via /admin/login (setup mode)
ADMIN_SETUP_SECRET=change-this-too
